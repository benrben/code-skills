{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benrben/code-skills/schemas/plugin-manifest.schema.json",
  "title": "Code Discipline Plugin Manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "author",
    "homepage",
    "repository",
    "keywords"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "const": "code-skills"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skills": {
      "type": "string",
      "minLength": 1
    },
    "interface": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
