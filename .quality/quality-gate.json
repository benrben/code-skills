{
  "gates": {
    "shortcuts": true,
    "secrets": true,
    "file_loc": true,
    "project_checks": true,
    "tests": true,
    "coverage": true,
    "complexity": true,
    "duplication": true,
    "dead_code": true,
    "vulnerabilities": true
  },
  "source": {
    "include": [],
    "exclude": [
      "tests/**",
      "test/**",
      "spec/**",
      "e2e/**",
      "**/tests/**",
      "**/test/**",
      "**/__tests__/**",
      "**/__mocks__/**",
      "**/*_test.*",
      "**/test_*.*",
      "**/*.test.*",
      "**/*.spec.*",
      "**/*_spec.*",
      "**/*.test-d.*",
      "**/*Test.java",
      "**/*Tests.java",
      "**/*Test.kt",
      "**/*Tests.kt",
      "**/*Tests.cs",
      "**/*Tests.swift"
    ]
  },
  "test": {
    "command": [
      ".venv/bin/python",
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests"
    ],
    "timeout_seconds": 900
  },
  "project_checks": {
    "commands": [
      [
        ".venv/bin/python",
        "-m",
        "ruff",
        "format",
        "--check",
        "repo_quality_gate.py",
        "skills/code-discipline/scripts",
        "tests"
      ],
      [
        ".venv/bin/python",
        "-m",
        "ruff",
        "check",
        "repo_quality_gate.py",
        "skills/code-discipline/scripts",
        "tests"
      ],
      [
        ".venv/bin/python",
        "-m",
        "mypy",
        "repo_quality_gate.py"
      ],
      [
        ".venv/bin/python",
        "-m",
        "mypy",
        "skills/code-discipline/scripts"
      ]
    ],
    "timeout_seconds": 600
  },
  "coverage": {},
  "tools": {
    "auto_install": false,
    "cache_dir": null
  },
  "setup": {
    "completed": true
  }
}
